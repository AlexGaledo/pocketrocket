[Unit]
Description=PocketRocket Crew screen (Xvfb + Chromium + noVNC)
After=network.target

[Service]
Type=simple
User=pocketrocket-crew
Group=pocketrocket-crew
Environment=HOME=/home/pocketrocket-crew
Environment=PATH=/home/pocketrocket-crew/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=POCKETROCKET_DATA=/home/pocketrocket-crew/pocketrocket-crew/data
Environment=XAUTHORITY=/home/pocketrocket-crew/pocketrocket-crew/data/desktop-home/.Xauthority
# Display and ports differ from stock PocketRocket (:99, 9222, 5900, 6080) so both can run on one VPS.
Environment=SCREEN_DISPLAY=:98
Environment=CDP_PORT=9223
Environment=VNC_PORT=5901
Environment=NOVNC_PORT=6081
ExecStart=/bin/bash /home/pocketrocket-crew/pocketrocket-crew/deploy/screen.sh
Restart=always
RestartSec=3
KillMode=control-group

# Hardening. This unit needs the real (non-private) /tmp: Xvfb's socket at /tmp/.X11-unix/X99 is
# also read by pocketrocket-crew.service's xdotool/scrot (the Desktop tool), which runs as a separate
# unit and would not see a PrivateTmp=yes namespace here. It also needs its own home for the
# Chromium/XFCE profile under data/.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp /home/pocketrocket-crew
PrivateTmp=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
